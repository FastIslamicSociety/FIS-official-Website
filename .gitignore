# ==========================================
# FIS Official Website - .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# Next.js Build Output & Cache
/.next/
/out/
/build
/dist
/.cache

# Environment Variables & Local Secrets (CRITICAL)
.env
.env*.local
.env.production
.env.staging
!.env.example

# Supabase Local Development
/supabase/.branches
/supabase/.temp
.supabase/

# Vercel Deployment & Build Cache
/.vercel

# Logs & Debug Output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
/coverage
/.nyc_output

# Operating System / System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Code Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Temporary Design Prototypes & Loose HTML Files (Cleaned Root)
/docs/design/
/*.html